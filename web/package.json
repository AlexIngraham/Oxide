{
  "name": "oxide-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11.2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "npm run verify:wasm",
    "dev": "vite",
    "prebuild": "npm run verify:wasm",
    "build": "tsc -b && vite build",
    "postbuild": "npm run verify:dist",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run verify:wasm && npm run lint && npm run test && npm run build",
    "prepreview": "npm run verify:wasm && npm run verify:dist",
    "preview": "vite preview",
    "build:wasm": "node scripts/build-wasm.mjs && npm run verify:wasm",
    "verify:wasm": "node scripts/verify-wasm.mjs",
    "verify:dist": "node scripts/verify-dist.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
